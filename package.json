{
  "name": "neo-core-serve",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Matrix-Core：neo 的核心运行时服务（独立进程、无终端依赖）",
  "bin": {
    "matrix-core": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "check": "bun x tsc --noEmit",
    "test": "bun test",
    "docs:check": "bun run scripts/docs-check.ts",
    "deps:scan": "bun run scripts/deps-scan.ts",
    "freeze:protocol": "bun run scripts/freeze-protocol.ts",
    "verify": "bash scripts/verify.sh",
    "e2e": "bun test tests/e2e",
    "guards": "bun test tests/guards",
    "commands:gen": "bun run scripts/gen-commands.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.7.0"
  }
}
